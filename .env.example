# ISEYC Digital Operations Centre — environment variables
# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (still MySQL — Postgres/Supabase migration is Phase 3) -------
DATABASE_URL=

# --- Supabase Auth (Phase 2) -------------------------------------------------
# Client-side (safe to expose in the browser bundle — these are public keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Supabase Dashboard -> Project Settings -> API -> JWT Secret.
# Used to verify user access tokens locally, with no network round-trip per request.
SUPABASE_JWT_SECRET=

# The Supabase Auth user id (UUID, from auth.users.id) of the ISEYC National
# President's account. On that account's first sign-in it is automatically
# bootstrapped to docRole="national_president", isAuthorizedOfficer=true,
# role="admin". Leave blank until that account has signed up once, then copy
# its id here and have it sign in again (or re-run the upsert) to bootstrap.
OWNER_AUTH_USER_ID=

# --- Legacy Manus Forge config (cron-callback verification only) -----------
# Required ONLY by server/_core/sdk.ts, which authenticates the Meeting &
# Decision Tracker's scheduled fallback callback. This whole block is
# removed in Phase 6 when that job moves to Vercel Cron.
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
